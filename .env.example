# ЛОКАЛЬНЫЙ запуск: скопируйте в .env и заполните (приложение читает .env автоматически).
# ВАЖНО для bothost.ru BotHost: на хостинге .env НЕ читается — задавайте эти же
# переменные во вкладке «Переменные» панели bot-manage.pl.

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Публичный адрес сайта на bothost.ru (https обязателен для мини-аппа)
PUBLIC_URL=https://bot-vdsrpg-verte82.bothost.tech
WEBAPP_URL=https://bot-vdsrpg-verte82.bothost.tech/app/?mode=fullscreen

# Секрет для однократной установки webhook: откройте /setup?secret=ЭТОТ_СЕКРЕТ
SETUP_SECRET=change-me-please

# Telegram ID администраторов/разработчиков (через запятую) — доступ к /admin и админ-панели
ADMIN_IDS=5992994003,1787475400

# Только для локального теста без настоящего Telegram (НЕ включайте на проде!)
# ALLOW_UNSAFE_INIT=1

# Порт локального запуска
PORT=8000
